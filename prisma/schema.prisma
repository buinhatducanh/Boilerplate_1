// ============================================================
// Prisma Schema – Web Agency Boilerplate
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Global Settings (Single config row)
// ============================================================

model GlobalSetting {
  id               Int      @id @default(autoincrement())
  siteName         String   @map("site_name") @db.VarChar(200)
  siteDescription  String   @map("site_description") @db.Text
  logo             String   @db.VarChar(500)
  favicon          String   @db.VarChar(500)
  email            String   @db.VarChar(200)
  phone            String   @db.VarChar(20)
  address          String   @db.Text
  socialLinks      Json     @default("[]") @map("social_links")
  footerText       String   @map("footer_text") @db.VarChar(500)
  googleAnalyticsId String? @map("google_analytics_id") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

// ============================================================
// Banners
// ============================================================

model Banner {
  id       Int      @id @default(autoincrement())
  title    String   @db.VarChar(200)
  subtitle String?  @db.VarChar(300)
  image    String   @db.VarChar(500)
  ctaText  String?  @map("cta_text") @db.VarChar(100)
  ctaLink  String?  @map("cta_link") @db.VarChar(500)
  isActive Boolean  @default(true) @map("is_active")
  order    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
  @@index([isActive, order])
}

// ============================================================
// Services
// ============================================================

model Service {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String   @db.Text
  icon        String   @db.VarChar(50)
  image       String?  @db.VarChar(500)
  features    String[] // PostgreSQL array
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
  @@index([slug])
  @@index([isActive, order])
}

// ============================================================
// Projects
// ============================================================

model Project {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  description String   @db.Text
  thumbnail   String   @db.VarChar(500)
  images      String[] // PostgreSQL array
  client      String   @db.VarChar(200)
  category    String   @db.VarChar(100)
  techStack   String[] @map("tech_stack")
  liveUrl     String?  @map("live_url") @db.VarChar(500)
  completedAt DateTime @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("projects")
  @@index([slug])
  @@index([category])
  @@index([completedAt(sort: Desc)])
}

// ============================================================
// Contact Messages
// ============================================================

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(200)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(300)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
  @@index([isRead, createdAt(sort: Desc)])
}
